# Copy this file to .env and adjust the values.
DATABASE_URL=sqlite:///./job_tracker.db

# Log every SQL statement SQLAlchemy runs, as JSON log lines at INFO level. Handy while developing.
SQL_ECHO=false

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Postgres example:
# DATABASE_URL=postgresql+psycopg2://jobtracker:change-me@localhost:5432/jobtracker
